# GRAVEN - Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
VITE_SITE_URL=https://graven-drafting-works.com

# Analytics (Plausible/Umami)
VITE_ANALYTICS_DOMAIN=graven-drafting-works.com
VITE_ANALYTICS_API_HOST=https://plausible.io

# Contact Form API (Netlify Functions / Vercel Serverless)
VITE_CONTACT_API_URL=/api/contact

# Newsletter API
VITE_NEWSLETTER_API_URL=/api/newsletter

# Turnstile (Cloudflare) - Client side
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-side secrets (not exposed to client)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# RESEND_API_KEY=your-resend-api-key
# CONTACT_EMAIL=hello@graven-drafting-works.com

# Sanity CMS (if using headless CMS)
# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=production
# SANITY_API_TOKEN=your-api-token

# Lighthouse CI (for performance audits)
# LHCI_GITHUB_APP_TOKEN=your-lhci-token

# Vercel (for deployment)
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id

# Slack (for deployment notifications)
# SLACK_WEBHOOK_URL=your-slack-webhook-url